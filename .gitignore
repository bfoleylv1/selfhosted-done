# macOS / editor noise
.DS_Store
Thumbs.db
*.swp
*~

# runtime state — config and data are mount points, not content
*/config/*
*/data/*
!*/config/.gitkeep
!*/data/.gitkeep

# local env overrides
.env
*.local.yml
docker-compose.override.yml

# python bytecode
__pycache__/
*.pyc

# internal generator state — not part of the published library
.tools/secret-salt
.tools/regcache.json
.tools/sh2_regcache.json
.tools/resolved.json
